[Unit]
Description=Temporary COA maintenance HTTPS tunnel
Wants=network-online.target caddy.service
After=network-online.target caddy.service

[Service]
Type=simple
User=coa-tunnel
Group=coa-tunnel
WorkingDirectory=/var/lib/coa-tunnel
StateDirectory=coa-tunnel
StateDirectoryMode=0700
ExecStart=/opt/coa-demo/tools/cloudflared-2026.11.0 tunnel --no-autoupdate --protocol http2 --url http://127.0.0.1:9899 --metrics 127.0.0.1:20242 --loglevel info
UnsetEnvironment=OPENAI_API_KEY COA_OPENAI_API_KEY_FILE COA_DEMO_BUDGET_FILE TUNNEL_TOKEN TUNNEL_ORIGIN_CERT CF_API_TOKEN CLOUDFLARE_API_TOKEN HCLOUD_TOKEN
Restart=on-failure
RestartSec=10
TimeoutStopSec=10
UMask=0077
NoNewPrivileges=yes
PrivateTmp=yes
ProtectHome=yes
ProtectSystem=strict
ReadWritePaths=/var/lib/coa-tunnel
CapabilityBoundingSet=
AmbientCapabilities=
MemoryMax=256M
CPUQuota=50%
TasksMax=128
StandardOutput=null
StandardError=journal
SyslogIdentifier=coa-demo-tunnel

[Install]
WantedBy=multi-user.target
